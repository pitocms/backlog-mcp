# Copy this file to .env and fill in your values.
#
# Backlog space base URL, e.g. https://yourspace.backlog.jp or https://yourspace.backlog.com
BACKLOG_BASE_URL=

# Backlog API key (Personal Settings > API)
BACKLOG_API_KEY=

# Project key of the target project, e.g. MYPROJ
BACKLOG_PROJECT_KEY=

# Optional: HTTP port for the MCP server (default 3000)
PORT=3000
